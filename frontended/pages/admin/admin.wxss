/* 管理后台 - 左侧边栏布局 */
.admin-page { display: flex; flex-direction: row; }
.admin-sidebar {
  width: 140rpx; background: var(--card-bg); flex-shrink: 0;
  padding: 16rpx 0; box-shadow: 2rpx 0 12rpx rgba(0,0,0,0.04);
  display: flex; flex-direction: column; gap: 4rpx;
  position: sticky; top: 0; align-self: flex-start;
}
.admin-sidebar { width: 160rpx; }
.admin-tab {
  display: flex; align-items: center; justify-content: center; position: relative;
  padding: 24rpx 8rpx; margin: 2rpx 12rpx; border-radius: var(--radius-md);
  font-size: 24rpx; color: var(--text-secondary); text-align: center;
}
.admin-tab-active { background: var(--primary-light); color: var(--primary); font-weight: 600; }
.admin-badge {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 14rpx; height: 14rpx; background: #E53E3E; border-radius: 50%; border: 2rpx solid #fff;
}
.admin-content { flex: 1; padding: 24rpx 20rpx; min-width: 0; }
