.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ededed;
  overflow: hidden;
}

/* ===== 顶部导航 ===== */
.chat-nav {
  background: #fff;
  border-bottom: 1rpx solid #e4e4e4;
  flex-shrink: 0;
}
.chat-nav-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}
.chat-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.back-icon {
  font-size: 40rpx;
  color: #333;
}
.chat-avatar-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: #FF7E67;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chat-avatar-sm image {
  width: 100%;
  height: 100%;
}
.avatar-sm-img {
  position: absolute; top: 0; left: 0;
  width: 72rpx; height: 72rpx; border-radius: 10rpx;
}
.avatar-img-overlay {
  position: absolute; top: 0; left: 0;
  width: 68rpx; height: 68rpx; border-radius: 8rpx;
}
.avatar-sm-letter {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.chat-title {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.chat-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chat-status {
  font-size: 22rpx;
  margin-top: 2rpx;
}

/* ===== 消息区域 ===== */
.msg-area {
  flex: 1;
  padding: 24rpx 24rpx 12rpx 24rpx;
  overflow-y: auto;
}
.msg-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
  color: #999;
  font-size: 28rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 消息行 — 不用 row-reverse */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}
.msg-left {
  justify-content: flex-start;
  padding-right: 80rpx;
}
.msg-right {
  justify-content: flex-end;
  padding-left: 80rpx;
  padding-right: 24rpx;
}

/* 消息头像 */
.msg-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 8rpx;
  background: #FF7E67;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.msg-left .msg-avatar {
  margin-right: 16rpx;
}
.msg-right .msg-avatar {
  margin-left: 16rpx;
}
.msg-avatar image {
  width: 100%;
  height: 100%;
}
.avatar-letter {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 气泡 */
.bubble {
  max-width: 440rpx;
  padding: 18rpx 22rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.bubble-left {
  background: #fff;
  color: #333;
  border-radius: 6rpx 18rpx 18rpx 18rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06);
}
.bubble-right {
  background: #95ec69;
  color: #000;
  border-radius: 18rpx 6rpx 18rpx 18rpx;
}
.bubble-img {
  max-width: 320rpx;
  border-radius: 8rpx;
  display: block;
}

/* ===== 输入栏 ===== */
.input-bar {
  background: #f7f7f7;
  border-top: 1rpx solid #e4e4e4;
  padding: 12rpx 16rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
.input-row {
  display: flex;
  align-items: center;
}
.input-img-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 10rpx;
  border-radius: 10rpx;
  background: #fff;
}
.input-img-btn:active {
  background: #e0e0e0;
}
.img-icon {
  font-size: 36rpx;
  color: #666;
  font-weight: bold;
}
.msg-input {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  margin-right: 12rpx;
}
.send-btn {
  width: 120rpx;
  height: 64rpx;
  background: #e0e0e0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}
.send-active {
  background: #07c160;
  color: #fff;
}
