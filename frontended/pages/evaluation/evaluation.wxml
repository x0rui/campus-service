<view class="container">
  <view class="card mt-30">
    <view class="flex-row" style="justify-content:center;align-items:center;gap:12rpx">
      <view wx:if="{{targetUser && targetUser.avatarUrl}}" style="width:64rpx;height:64rpx;border-radius:50%;overflow:hidden;flex-shrink:0">
        <image src="{{targetUser.avatarUrl}}" mode="aspectFill" style="width:100%;height:100%"/>
      </view>
      <view class="text-lg text-bold">评价{{targetUser ? targetUser.nickName : '对方'}}</view>
    </view>
    <view class="text-sm text-gray mt-10" style="text-align:center">
      {{orderType === 0 ? '跑腿任务' : orderType === 1 ? '闲置交易' : orderType === 2 ? '组局评价' : '社团评价'}} #{{orderId}}
    </view>

    <!-- 星级评分 -->
    <view class="score-area mt-30">
      <view class="text-bold mb-10">评分</view>
      <view class="flex-row" style="justify-content:center;gap:8rpx">
        <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
              style="font-size:48rpx;line-height:1;{{item<=score?'color:var(--primary)':'color:var(--text-muted)'}}"
              bindtap="setScore" data-score="{{item}}">★</view>
      </view>
      <view class="text-center text-sm text-muted mt-5">
        <text wx:if="{{score===0}}">点击星星评分</text>
        <text wx:elif="{{score===1}}">非常差</text>
        <text wx:elif="{{score===2}}">较差</text>
        <text wx:elif="{{score===3}}">一般</text>
        <text wx:elif="{{score===4}}">满意</text>
        <text wx:elif="{{score===5}}">非常满意</text>
      </view>
    </view>

    <!-- 评价内容 -->
    <view class="form-group mt-30">
      <view class="form-label">评价内容（选填）</view>
      <textarea class="form-textarea" placeholder="说说你的体验..."
                value="{{content}}" bindinput="onContentInput" />
    </view>

    <!-- 按钮 -->
    <view class="flex-row mt-30">
      <button class="btn-outline flex-1" style="margin-right:16rpx" bindtap="skip">跳过</button>
      <button class="btn-primary flex-1" bindtap="submit" loading="{{submitting}}">提交评价</button>
    </view>
  </view>
</view>
