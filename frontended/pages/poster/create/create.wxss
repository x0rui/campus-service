.p-canvas { width: 520rpx; height: 640rpx; border-radius: var(--radius-lg); box-shadow: 0 8rpx 36rpx rgba(0,0,0,0.1); }
.p-preview { display: flex; justify-content: center; padding: 16rpx 0 24rpx; }
.p-card { padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.p-label { font-size: 24rpx; font-weight: 500; color: var(--text-secondary); margin-bottom: 12rpx; display: block; }
.p-input-row { display: flex; gap: 12rpx; }
.p-input {
  height: 76rpx; background: var(--card-bg); color: var(--text);
  border: 2rpx solid var(--border); border-radius: var(--radius-md);
  padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box;
}
.p-field { margin-bottom: 20rpx; }
.p-hint { display: block; margin-top: 12rpx; }
.p-btn-small { padding: 0 20rpx; height: 76rpx; border-radius: var(--radius-md); display: flex; align-items: center; font-size: 24rpx; white-space: nowrap; flex-shrink: 0; }
.p-btn-primary { background: var(--primary); color: #fff; }
.p-actions { display: flex; gap: 16rpx; }
.p-btn { flex: 1; padding: 26rpx 0; border-radius: var(--radius-md); text-align: center; font-size: 28rpx; font-weight: 500; box-sizing: border-box; }
.p-btn-solid { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; border: none; }
.p-btn-outline { background: #fff; color: var(--primary); border: 2rpx solid var(--primary); }
