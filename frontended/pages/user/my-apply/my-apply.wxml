<view class="container">
  <view wx:if="{{list.length===0}}" class="empty-state"><text>暂无申请记录</text></view>
  <view class="card" wx:for="{{list}}" wx:key="appId" style="border-left:8rpx solid {{item.status===0?'var(--accent)':item.status===1?'#48BB78':'#FC8181'}}">
    <view class="flex-row flex-between">
      <view class="text-bold">{{item.clubName}}</view>
      <view class="tag {{item.status===0?'tag-warning':item.status===1?'tag-success':'tag-danger'}}">
        {{item.status===0?'待审核':item.status===1?'已通过':'已拒绝'}}
      </view>
    </view>
    <view class="text-sm text-body mt-5">{{item.description}}</view>
    <view class="text-xs text-muted mt-5">{{item.createTime}}</view>
  </view>
</view>
