/* 认证页 - 与编辑资料页统一风格 */
.verify-card { padding: 0; overflow: hidden; }

.verify-section {
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--border);
}
.verify-section:last-child { border-bottom: none; }

.verify-section-title {
  font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx;
  display: flex; align-items: center; gap: 12rpx;
}
.verify-section-title::before {
  content: ''; width: 6rpx; height: 26rpx;
  background: var(--primary); border-radius: 3rpx; display: block;
}

.verify-field { margin-bottom: 28rpx; }
.verify-field:last-child { margin-bottom: 0; }
.verify-field-half { flex: 1; }
.verify-label {
  display: block; font-size: 24rpx; font-weight: 500;
  color: var(--text-secondary); margin-bottom: 10rpx;
}
.verify-input {
  width: 100%; height: 76rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  display: flex; align-items: center;
}
.verify-row { display: flex; gap: 24rpx; margin-bottom: 28rpx; }
.verify-row:last-child { margin-bottom: 0; }
.verify-select {
  width: 100%; height: 76rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between;
}

/* 校园卡上传区 */
.verify-card-grid { display: flex; gap: 24rpx; }
.verify-card-side { flex: 1; text-align: center; }
.verify-card-label { font-size: 22rpx; color: var(--text-muted); margin-bottom: 10rpx; }
.verify-card-box {
  width: 100%; height: 200rpx;
  background: linear-gradient(135deg, var(--primary-light), #FFF5F0);
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.verify-card-placeholder { font-size: 24rpx; color: var(--text-muted); }
