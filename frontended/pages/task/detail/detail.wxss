.detail-body { padding: 20rpx; padding-bottom: 140rpx; }
.location-dot {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  margin-right: 16rpx; margin-top: 8rpx; flex-shrink: 0;
}
.location-dot.pickup { background: #27ae60; }
.location-dot.delivery { background: #e74c3c; }
.seller-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #eee;
}
.seller-avatar-text {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #FF7E67;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 600; flex-shrink: 0;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  display: flex;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
