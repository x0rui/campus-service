/* 举报页 */
.report-card { padding: 0; }
.report-target-box { background: #F5F6FA; border-radius: var(--radius-md); padding: 18rpx 24rpx; font-size: 26rpx; color: var(--text); }
.report-warning { background: #FFF8F0; border-radius: var(--radius-sm); padding: 16rpx 20rpx; }
.report-warning-text { font-size: 22rpx; color: #C17A1A; line-height: 1.6; }
.form-section { padding: 0 24rpx; }
.form-section-first { padding: 24rpx 24rpx 0; }
.form-section-last { padding: 16rpx 24rpx 20rpx; }
