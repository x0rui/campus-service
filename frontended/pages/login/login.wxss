.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(150deg, #FF7E67 0%, #4ECDC4 100%);
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}
.login-container::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 600rpx;
  height: 600rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}
.login-container::after {
  content: '';
  position: absolute;
  bottom: -100rpx;
  left: -150rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 50%;
}

.login-header {
  text-align: center;
  margin-bottom: 100rpx;
  position: relative;
  z-index: 1;
}
.app-logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.app-desc {
  color: rgba(255,255,255,0.75);
  font-size: 28rpx;
}
.login-body {
  width: 100%;
  position: relative;
  z-index: 1;
}
.login-btn {
  background: #fff;
  color: #FF7E67;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  transition: transform 0.2s;
  border: none;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-btn:active {
  transform: scale(0.97);
}
