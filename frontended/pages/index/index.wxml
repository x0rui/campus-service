<view class="container">
  <!-- 品牌头部 - 亮色卡片，个性化欢迎 -->
  <view class="brand-header brand-header-light">
    <view class="flex-row flex-between" style="align-items:flex-start">
      <view>
        <view class="greeting">{{greeting}}</view>
        <view class="text-xl text-heavy mt-5">{{userInfo.nickName || '同学'}}</view>
        <view class="greeting-hint">{{greetingHint}}</view>
      </view>
      <view class="brand-avatar">
        <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" class="avatar-image"/>
        <text wx:else class="brand-avatar-text">{{userInfo.nickName ? userInfo.nickName.charAt(0) : '我'}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 四宫格 -->
  <view class="grid-2col" style="margin:-16rpx 0 12rpx 0;position:relative;z-index:2">
    <view class="grid-entry card-left-primary" bindtap="goTo" data-url="/pages/goods/list/list">
      <view class="grid-entry-icon" style="background:#FFF0EC">
        <text style="color:var(--primary);font-size:26rpx;font-weight:700">闲</text>
      </view>
      <view class="grid-entry-label">逛闲置</view>
    </view>
    <view class="grid-entry" style="border-left:8rpx solid var(--secondary)" bindtap="goTo" data-url="/pages/task/square/square">
      <view class="grid-entry-icon" style="background:#E8FAF8">
        <text style="color:var(--secondary);font-size:26rpx;font-weight:700">跑</text>
      </view>
      <view class="grid-entry-label">跑个腿</view>
    </view>
    <view class="grid-entry" style="border-left:8rpx solid var(--accent)" bindtap="goTo" data-url="/pages/team/square/square">
      <view class="grid-entry-icon" style="background:#FFFAF0">
        <text style="color:#DD6B20;font-size:26rpx;font-weight:700">组</text>
      </view>
      <view class="grid-entry-label">去组团</view>
    </view>
    <view class="grid-entry" style="border-left:8rpx solid var(--tertiary)" bindtap="goTo" data-url="/pages/club/square/square">
      <view class="grid-entry-icon" style="background:var(--tertiary-light)">
        <text style="color:var(--tertiary);font-size:26rpx;font-weight:700">社</text>
      </view>
      <view class="grid-entry-label">社团</view>
    </view>
  </view>
  <view style="margin-bottom:24rpx">
    <view class="grid-entry" style="border-left:8rpx solid var(--accent);background:var(--card-bg);border-radius:var(--radius-lg);padding:16rpx 20rpx;display:flex;align-items:center;gap:12rpx" bindtap="goTo" data-url="/pages/ranking/ranking">
      <view style="width:40rpx;height:40rpx;background:#FDEAEA;border-radius:10rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <text style="color:#E53E3E;font-size:22rpx;font-weight:700">榜</text>
      </view>
      <text style="font-size:28rpx;font-weight:600;flex:1">排行榜</text>
      <text style="font-size:24rpx;color:var(--text-muted)">›</text>
    </view>
  </view>

  <!-- 校园圈 -->
  <view class="section">
    <view class="flex-row flex-between mb-10">
      <view class="flex-row" style="gap:8rpx">
        <view style="width:8rpx;height:28rpx;background:var(--tertiary);border-radius:4rpx;margin-right:12rpx"></view>
        <view class="text-lg text-bold">校园圈</view>
      </view>
      <view class="btn-small" style="background:var(--tertiary);color:#fff;width:auto;padding:4rpx 16rpx;font-size:22rpx" bindtap="goTo" data-url="/pages/campus-circle/publish/publish">发布</view>
    </view>
    <view class="tab-bar mb-15">
      <view class="tab-item {{activeCircleTab===0?'tab-active':''}}" bindtap="switchCircleTab" data-type="0">闲聊</view>
      <view class="tab-item {{activeCircleTab===1?'tab-active':''}}" bindtap="switchCircleTab" data-type="1">公告</view>
    </view>
    <block wx:if="{{!loading && circlePosts.length > 0}}">
      <view class="card card-left-tertiary" wx:for="{{circlePosts}}" wx:key="id" bindtap="goToCampusCircle" data-id="{{item.id}}" style="{{item.type===1?'border-color:var(--secondary)':''}}">
        <view class="flex-row flex-between mb-10">
          <view class="flex-row" style="gap:12rpx">
            <view class="avatar-circle" style="background:{{item.type===1?'var(--secondary-light)':'var(--tertiary-light)'}}">
              <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="avatar-image"/>
              <text wx:else class="avatar-circle-text" style="color:{{item.type===1?'var(--secondary)':'var(--tertiary)'}}">{{item.nickName ? item.nickName.charAt(0) : '匿'}}</text>
            </view>
            <view>
              <view class="flex-row" style="gap:8rpx">
                <text class="text-sm text-bold">{{item.nickName || '同学'}}</text>
                <view wx:if="{{item.role===2}}" class="tag tag-danger" style="padding:2rpx 10rpx;font-size:18rpx">管理员</view>
                <view wx:elif="{{item.role===1}}" class="tag tag-success" style="padding:2rpx 10rpx;font-size:18rpx">社团</view>
              </view>
              <text class="text-xs text-muted">{{item.createTime}}</text>
            </view>
          </view>
          <view class="tag {{item.type===1?'tag-success':'tag-muted'}}">{{item.type===1?'公告':'闲聊'}}</view>
        </view>
        <view class="text-bold text-ellipsis" style="font-size:28rpx">{{item.title}}</view>
        <view class="text-xs text-body mt-5 text-line3">{{item.content}}</view>
        <view class="flex-row mt-10" style="gap:24rpx">
          <text style="font-size:22rpx;color:var(--text-muted)">赞 {{item.likeCount||0}}</text>
          <text style="font-size:22rpx;color:var(--text-muted)">评 {{item.commentCount||0}}</text>
        </view>
      </view>
      <view class="circle-section-more" bindtap="goTo" data-url="/pages/campus-circle/list/list">
        <text class="text-sm text-tertiary">看看更多</text>
      </view>
    </block>
    <view wx:elif="{{!loading && circlePosts.length === 0}}" class="empty-state" style="padding:60rpx 0">
      <text style="font-size:56rpx;opacity:0.35;margin-bottom:16rpx">·</text>
      <text>{{activeCircleTab===0?'还没有人闲聊，来发第一条吧':'暂无公告'}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="load-more">加载中...</view>
</view>
