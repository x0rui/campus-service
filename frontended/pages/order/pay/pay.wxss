.pay-amount {
  text-align: center;
  padding: 40rpx 0 32rpx;
}
.pay-amount .amount {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0 8rpx;
}
.pay-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border);
}
.pay-row:last-child { border-bottom: none; }
.pay-row-active { background: var(--primary-light); border-radius: var(--radius-md); padding-left: 16rpx; padding-right: 16rpx; }
.pay-dot {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  color: #fff; font-size: 28rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx; flex-shrink: 0;
}
.pay-check { font-size: 32rpx; color: var(--primary); }
.notice {
  font-size: 22rpx; color: var(--text-muted); line-height: 1.7;
  background: var(--primary-light); border-radius: var(--radius-md);
  padding: 20rpx 24rpx; margin-top: 16rpx;
}
