.option {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-top: 16rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.option-active {
  border-color: #FF7E67;
  background: #FFF6F4;
}
.option-key {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5f5f5;
  margin-right: 16rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
.option-active .option-key {
  background: #FF7E67;
  color: #fff;
}
.btn-outline {
  padding: 20rpx 0;
  border: 2rpx solid #FF7E67;
  color: #FF7E67;
  border-radius: 12rpx;
  font-size: 28rpx;
}
