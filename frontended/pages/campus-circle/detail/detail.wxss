/* 校园圈详情页 */
.detail-post-content { line-height: 1.8; font-size: 28rpx; color: var(--text-secondary); margin-top: 20rpx; }
.detail-actions { display: flex; align-items: center; gap: 24rpx; }
.detail-action { display: flex; align-items: center; gap: 6rpx; }
.detail-action-icon { font-size: 28rpx; color: var(--text-muted); }
.detail-action-num { font-size: 24rpx; }
.detail-owner-btns { display: flex; align-items: center; gap: 8rpx; }
.detail-owner-btn { font-size: 22rpx; border-radius: var(--radius-sm); padding: 6rpx 16rpx; }

/* 评论输入栏 */
.comment-bar { position: sticky; bottom: 0; background: #fff; border-top: 2rpx solid var(--border); }
.comment-bar-inner { display: flex; gap: 8rpx; padding: 16rpx 20rpx; }
.comment-input { flex: 1; min-height: 64rpx; font-size: 26rpx; }
.comment-send-btn { font-size: 24rpx; padding: 12rpx 20rpx; }

/* 置顶评论标签 */
.pin-tag { font-size: 18rpx; padding: 2rpx 10rpx; }
.user-role-tiny { font-size: 16rpx; padding: 1rpx 8rpx; transform: scale(0.85); display: inline-block; }
