.notify-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.notify-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  font-size: 26rpx;
}

.notify-count { color: #999; }

.notify-mark-all {
  color: #3B82F6;
  font-size: 26rpx;
}

.notify-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  color: #999;
}

.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; }

.notify-row {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.notify-row.unread { background: #f0f7ff; }

.notify-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #3B82F6;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notify-body {
  flex: 1;
  min-width: 0;
}

.notify-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.notify-content {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.notify-time {
  font-size: 22rpx;
  color: #bbb;
}

.notify-arrow {
  color: #ccc;
  font-size: 28rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

.safe-bottom { height: 60rpx; }
