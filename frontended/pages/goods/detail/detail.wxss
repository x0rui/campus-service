.swiper { width: 100%; height: 560rpx; }
.swiper image { width: 100%; height: 100%; }
.no-img {
  width: 100%;
  height: 400rpx;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}
.detail-body { padding: 20rpx; padding-bottom: 140rpx; }
.seller-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #eee;
}
.seller-avatar-text {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #FF7E67;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 600; flex-shrink: 0;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  display: flex;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
