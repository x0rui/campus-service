.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}
.category-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: var(--card-bg);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}
.category-active {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

.goods-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}
.goods-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(255, 126, 103, 0.04);
}
.goods-img {
  width: 100%;
  height: 280rpx;
}
.goods-img-placeholder {
  width: 100%;
  height: 280rpx;
  background: #FFF0EC;
  display: flex;
  align-items: center;
  justify-content: center;
}
.goods-info {
  padding: 14rpx 16rpx 18rpx;
}
