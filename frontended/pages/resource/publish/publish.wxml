<view class="container">
  <view class="card">
    <view class="card-body">
      <view class="form-group">
        <view class="form-label">资料标题</view>
        <input class="form-input" placeholder="如：数据结构第3章 树与二叉树课件"
               value="{{title}}" bindinput="onTitleInput" maxlength="60" />
      </view>

      <view class="form-group">
        <view class="form-label">所属课程</view>
        <input class="form-input" placeholder="如：数据结构" value="{{course}}" bindinput="onCourseInput" maxlength="30" />
      </view>

      <view class="form-group">
        <view class="form-label">资料类型</view>
        <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="form-input">{{types[typeIndex]}} ▾</view>
        </picker>
      </view>

      <view class="form-group">
        <view class="form-label">资料说明（选填）</view>
        <textarea class="form-textarea" placeholder="简单说明内容或适用范围"
                  value="{{description}}" bindinput="onDescInput" maxlength="300" />
      </view>

      <view class="form-group">
        <view class="form-label">上传文件</view>
        <view class="flex-row">
          <view class="btn-ghost" style="margin-right:16rpx" bindtap="chooseFile">选文件</view>
          <view class="btn-ghost" bindtap="chooseImage">选图片</view>
        </view>
        <view class="text-sm mt-5" wx:if="{{fileName}}">已选：{{fileName}}</view>
        <view class="text-sm text-muted mt-5" wx:elif="{{uploading}}">上传中...</view>
      </view>
    </view>
  </view>

  <view class="btn-primary text-center" bindtap="submit" style="margin:24rpx 0">
    {{submitting ? '提交中...' : '提交审核'}}
  </view>
</view>
